{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "radtrails",
	"compatibility_date": "2026-06-17",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "radtrails"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"vars": {
		// Not a secret: the client id travels in every redirect URL to Google.
		// GOOGLE_CLIENT_SECRET and ADMIN_BOOTSTRAP_TOKEN are Cloudflare secrets,
		// never vars in this file.
		"GOOGLE_CLIENT_ID": "357644174029-7udsq7f5v70d86f760nb5t15j2kg237q.apps.googleusercontent.com"
	},
	"d1_databases": [
		{
			// Application database: users, sessions, personas, profiles, images, and per-user data.
			// Apply schema changes with `npm run db:migrate:local` / `npm run db:migrate:remote`.
			"binding": "DB",
			"database_name": "radtrails-app",
			"database_id": "c35f4283-dfa3-4d62-b246-fac86323b76f",
			"migrations_dir": "migrations"
		}
	],
	"ratelimits": [
		{
			"name": "LOGIN_RATE_LIMITER",
			"namespace_id": "73001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "WRITE_RATE_LIMITER",
			"namespace_id": "73002",
			"simple": {
				"limit": 60,
				"period": 60
			}
		},
		{
			"name": "IMAGE_RATE_LIMITER",
			"namespace_id": "73003",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"env": {
		"preview": {
			"name": "radtrails-preview",
			"routes": [
				{
					"pattern": "preview.radtrails.org",
					"custom_domain": true
				}
			],
			"assets": {
				"directory": ".open-next/assets",
				"binding": "ASSETS"
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "radtrails-preview"
				}
			],
			"images": {
				"binding": "IMAGES"
			},
			"vars": {
				"GOOGLE_CLIENT_ID": "357644174029-7udsq7f5v70d86f760nb5t15j2kg237q.apps.googleusercontent.com"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "radtrails-app",
					"database_id": "c35f4283-dfa3-4d62-b246-fac86323b76f",
					"migrations_dir": "migrations"
				}
			],
			"ratelimits": [
				{
					"name": "LOGIN_RATE_LIMITER",
					"namespace_id": "73001",
					"simple": { "limit": 10, "period": 60 }
				},
				{
					"name": "WRITE_RATE_LIMITER",
					"namespace_id": "73002",
					"simple": { "limit": 60, "period": 60 }
				},
				{
					"name": "IMAGE_RATE_LIMITER",
					"namespace_id": "73003",
					"simple": { "limit": 10, "period": 60 }
				}
			]
		}
	}
}
