{
  "name": "radtrails.com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs --cloudflare",
    "next:build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:build": "node scripts/build.mjs --cloudflare",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:preview:upload": "wrangler versions upload --preview-alias preview",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && npm run cf:deploy",
    "cf:types": "wrangler types",
    "db:create": "wrangler d1 create radtrails-app",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply radtrails-app --remote",
    "db:console:local": "wrangler d1 execute DB --local --command"
  },
  "dependencies": {
    "@fullcalendar/react": "^7.1.3",
    "lenis": "^1.3.27",
    "motion": "^14.6.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.0.1",
    "temporal-polyfill": "^1.0.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20261019.1": true
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  }
}
